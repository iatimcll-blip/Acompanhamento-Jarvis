{
  "manifest_version": 3,
  "name": "Jarvis · WhatsApp deste aparelho",
  "version": "1.0.1",
  "description": "Liga o Painel WhatsApp do Jarvis ao WhatsApp Web DESTE navegador: cada aparelho usa o próprio WhatsApp, sem ponte nem PC principal.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://iatimcll-blip.github.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["wppconnect-wa.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["wa-adaptador.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["wa-relay.js"], "run_at": "document_start" },
    { "matches": ["https://iatimcll-blip.github.io/Acompanhamento-Jarvis/*"], "js": ["painel-shim.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://iatimcll-blip.github.io/Acompanhamento-Jarvis/*"], "js": ["painel-ponte.js"], "run_at": "document_start" }
  ]
}
